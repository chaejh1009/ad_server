# Copy this file to .env and replace the placeholder values.
MONGO_URI=mongodb://localhost:27017/?replicaSet=ads-rs
MONGO_DB=village_ads
ADS_SECRET_KEY=replace-with-a-random-secret-key
ADS_BASE_URL=http://127.0.0.1:8001
ADS_MEDIA_ID=village-game
# Use the same media key in the game server configuration.
ADS_MEDIA_KEY=replace-with-a-shared-media-key
